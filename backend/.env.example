FLASK_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=terrain_optimizer
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_PERSISTENCE_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
EXTERNAL_API_TIMEOUT=15
ROUTE_MAX_DISTANCE_METERS=5000
MULTI_STOP_EXACT_THRESHOLD=8
